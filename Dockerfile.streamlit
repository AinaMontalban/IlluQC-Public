FROM python:3.11-slim

WORKDIR /opt/ngsqc

COPY app/ /opt/ngsqc/app/

RUN python -m pip install --upgrade pip && \
    if [ -f /opt/ngsqc/app/requirements.txt ]; then \
      pip install -r /opt/ngsqc/app/requirements.txt; \
    else \
      pip install streamlit pandas sqlalchemy psycopg2-binary; \
    fi

RUN mkdir -p /logs/app /config

EXPOSE 8501

CMD ["streamlit", "run", "/opt/ngsqc/app/IlluQC_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
