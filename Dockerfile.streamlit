FROM python:3.11-slim

WORKDIR /opt/ngsqc

COPY app/ /opt/ngsqc/app/

RUN python -m pip install --upgrade pip && \
    if [ -f /opt/ngsqc/app/requirements.txt ]; then \
      pip install -r /opt/ngsqc/app/requirements.txt; \
    else \
      pip install streamlit pandas sqlalchemy psycopg2-binary; \
    fi

RUN groupadd --gid 10001 ngsqc && \
    useradd --uid 10001 --gid ngsqc --create-home ngsqc && \
    mkdir -p /home/ngsqc/.streamlit /logs/app /config && \
    chown -R ngsqc:ngsqc /home/ngsqc /opt/ngsqc /logs /config

USER ngsqc

ENV HOME=/home/ngsqc \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

EXPOSE 8501

CMD ["streamlit", "run", "/opt/ngsqc/app/IlluQC_app.py", "--server.address=0.0.0.0", "--server.port=8501"]


