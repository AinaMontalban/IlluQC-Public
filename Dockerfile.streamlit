FROM python:3.11-slim

WORKDIR /opt/illuqc

COPY app/ /opt/illuqc/app/

RUN python -m pip install --no-cache-dir --upgrade pip && \
    if [ -f /opt/illuqc/app/requirements.txt ]; then \
      pip install --no-cache-dir -r /opt/illuqc/app/requirements.txt; \
    else \
      pip install --no-cache-dir streamlit pandas sqlalchemy psycopg2-binary; \
    fi

RUN groupadd --gid 1001 illuqc && \
    useradd --uid 1001 --gid illuqc --create-home illuqc && \
    mkdir -p /home/illuqc/.streamlit /logs/app /config && \
    chown -R illuqc:illuqc /home/illuqc /opt/illuqc /logs /config

USER illuqc

ENV HOME=/home/illuqc \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

EXPOSE 8501

CMD ["streamlit", "run", "/opt/illuqc/app/IlluQC_app.py", "--server.address=0.0.0.0", "--server.port=8501"]

