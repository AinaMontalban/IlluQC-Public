# =========================
# NGS general config
# =========================

PROJECT_NAME=illuqc
ILLUQC_VERSION=0.1.0

# Match these to `id -u` and `id -g` on Linux hosts when bind-mounted files
# must be writable by your host account.
LOCAL_UID=10001
LOCAL_GID=10001

# External data root
NGS_DATA_ROOT=../NGS_Data

# External folders
ILLUMINA_RAW_DATA_DIR=/Users/amontalban/HCB-Work/Doctorat/NGSQC/Input_Data/Illumina_Runs_Data
THERMOFISHER_RAW_DATA_DIR=/Users/amontalban/HCB-Work/Doctorat/NGSQC/Input_Data/Thermofisher_Runs_Data
PROCESSED_DATA_DIR=../NGS_Data/processed
LOG_DIR=../NGS_Data/logs
BACKUP_DIR=../NGS_Data/backups
POSTGRES_DATA_DIR=../NGS_Data/postgres_data
CONFIG_DIR=../NGS_Data/config

# PostgreSQL
POSTGRES_USER=illuqc
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=illuqcdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Streamlit
STREAMLIT_PORT=8501

# Parser
PARSER_LOG_LEVEL=INFO
