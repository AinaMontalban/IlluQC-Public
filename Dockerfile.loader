FROM python:3.11-slim

WORKDIR /opt/ngsqc

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY db/ /opt/ngsqc/db/
COPY init-db/ /opt/ngsqc/init_db/

RUN pip install --no-cache-dir -r /opt/ngsqc/db/requirements.txt

RUN groupadd --gid 10001 ngsqc && \
    useradd --uid 10001 --gid ngsqc --no-create-home ngsqc && \
    mkdir -p /data/processed /logs && \
    chown -R ngsqc:ngsqc /data /logs /opt/ngsqc

USER ngsqc

ENTRYPOINT ["python", "/opt/ngsqc/db/upload_CSV.py"]
