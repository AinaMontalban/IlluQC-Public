FROM python:3.11-slim

WORKDIR /opt/illuqc

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY parser/ /opt/illuqc/parser/

RUN if [ -f /opt/illuqc/parser/Illumina_Runs/requirements.txt ]; then \
      pip install --no-cache-dir -r /opt/illuqc/parser/Illumina_Runs/requirements.txt; \
    elif [ -f /opt/illuqc/parser/requirements.txt ]; then \
      pip install --no-cache-dir -r /opt/illuqc/parser/requirements.txt; \
    fi

RUN groupadd --gid 10001 illuqc && \
    useradd --uid 10001 --gid illuqc --no-create-home illuqc && \
    mkdir -p /data/raw /data/processed /logs && \
    chown -R illuqc:illuqc /data /logs /opt/illuqc

USER illuqc

ENTRYPOINT ["python", "/opt/illuqc/parser/Illumina_Runs/Illumina_sequencing_data_parser.py"]
