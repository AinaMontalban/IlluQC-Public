Bootstrap: docker
From: python:3.11-slim

%labels
    Author NGSQC Team
    Version 1.0
    Description Illumina NGS-QC Parser - Singularity Container

%help
    This container runs the Illumina sequencing data parser.
    
    Usage:
        singularity run illumina_parser.sif \
            --run-folder /path/to/run \
            --output-dir /path/to/output \
            --run-description "MY_DESCRIPTION"

%environment
    export PATH=$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

%post
    # Update system packages
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        && rm -rf /var/lib/apt/lists/*
    
    # Create app directory
    mkdir -p /app
    
    # Install Python dependencies
    pip install --no-cache-dir interop==1.9.0

%files
    Illumina_sequencing_data_parser.py /app/
    illumina_parser_config.json /app/
    requirements.txt /app/

%appenv
    export PYTHONUNBUFFERED=1

%runscript
    cd /app
    exec python Illumina_sequencing_data_parser.py "$@"
