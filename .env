# =========================
# NGS general config
# =========================

PROJECT_NAME=ngsqc

# External data root
NGS_DATA_ROOT=../NGS_Data

# External folders
ILLUMINA_RAW_DATA_DIR=../Input_Data/Illumina_Runs_Data
THERMOFISHER_RAW_DATA_DIR=../Input_Data/Thermofisher_Runs_Data
PROCESSED_DATA_DIR=../NGS_Data/processed
LOG_DIR=../NGS_Data/logs
BACKUP_DIR=../NGS_Data/backups
POSTGRES_DATA_DIR=../NGS_Data/postgres_data
CONFIG_DIR=../NGS_Data/config

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ngsqcdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Streamlit
STREAMLIT_PORT=8501
NGS_DB_URL=postgresql://postgres:postgres@db:5432/ngsqcdb

# Parser
PARSER_LOG_LEVEL=INFO
